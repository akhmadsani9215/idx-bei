# Neo4j configuration
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Alpha Index API (external market data — not local SoT)
# Get a Bearer token from Alpha Index; never commit real keys.
ALPHA_INDEX_BASE_URL=https://api.indexalpha.id
ALPHA_INDEX_API_KEY=
